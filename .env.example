# ==============================================================================
# Cognivora AI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#    cp .env.example .env
# 2. Add your Google Gemini API Key below.
#    Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# 3. If you do not have an API key right now, Cognivora AI will automatically
#    activate its built-in high-fidelity Demonstration Curriculum Engine!
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="Cognivora AI — Educational Content Generator"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/cognivora.db

# Vector Storage Configuration
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/vector_store
CHROMA_COLLECTION_NAME=cognivora_curriculum_chunks

# LLM Providers Configuration
PRIMARY_LLM_PROVIDER=google_genai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Selected Foundation Models
DEFAULT_ORCHESTRATOR_MODEL=gemini-2.5-flash
PRIMARY_MODEL=gemini-2.5-flash
FAST_GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=text-embedding-004

# Document Upload & Processing Settings
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=["pdf","docx","txt"]

# Voice & Audio Processing
TTS_PROVIDER=web_speech_api
STT_PROVIDER=web_speech_api
TTS_VOICE=en-US-Standard

# Observability & Telemetry
AGENT_DEBUG=True
LOG_LEVEL=INFO
ENABLE_AGENT_TELEMETRY=True
