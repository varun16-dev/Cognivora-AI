# ==============================================================================
# EduGen AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="EduGen AI - Educational Content Generator"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edugen_ai
DB_ECHO=False

# Vector Database Configuration
# Options: chroma, pgvector
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/vector_store
CHROMA_COLLECTION_NAME=edugen_documents

# LLM Provider Configuration
# Supported providers: google_genai, openai, groq
PRIMARY_LLM_PROVIDER=google_genai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Selected Models (Will be benchmarked and finalized in Week 2)
DEFAULT_ORCHESTRATOR_MODEL=gemini-1.5-pro
FAST_GENERATION_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=text-embedding-004

# Document Upload & Storage Settings
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=["pdf","docx","txt"]

# Voice & Audio Processing (Week 4 / 6 Advanced Feature)
STT_PROVIDER=whisper_local
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-ChristopherNeural

# Agent & Observability
AGENT_DEBUG=True
LOG_LEVEL=INFO
ENABLE_AGENT_TELEMETRY=True
